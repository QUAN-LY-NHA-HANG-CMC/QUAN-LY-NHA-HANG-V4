          }
        },
        {
          "name": "2.8 Xem lịch sử thay đổi quyền (Audit Trail)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/vai-tro/lich-su-thay-doi?trang=1&soLuong=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vai-tro", "lich-su-thay-doi"],
              "query": [
                { "key": "trang", "value": "1" },
                { "key": "soLuong", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "2.9 Xóa vai trò tùy chỉnh",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/vai-tro/5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vai-tro", "5"]
            }
          }
        }
      ]
    },
