{
  "info": {
    "_postman_id": "b3e098a5-d52f-48d6-95bc-79f977d0e41a",
    "name": "Quản Lý Nhà Hàng & Gọi Món QR - Auth, RBAC & System Config",
    "description": "Bộ sưu tập Postman Collection đầy đủ cho Sprint 1: Bảo mật, Tài khoản, Vai trò, Phân quyền RBAC, Cấu hình nhà hàng và Nhật ký hệ thống.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Xác thực & Tài khoản cá nhân (Auth & Profile)",
      "item": [
        {
          "name": "1.1 Đăng nhập (Quản lý) - Tự động lưu Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.ok && res.data && res.data.tokens) {",
                  "    pm.collectionVariables.set('accessToken', res.data.tokens.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', res.data.tokens.refreshToken);",
                  "    console.log('Đã lưu Access Token và Refresh Token vào biến môi trường!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"quanly\",\n  \"matKhau\": \"MatKhau@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tai-khoan/dang-nhap",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tai-khoan", "dang-nhap"]
            }
          }
        },
        {
          "name": "1.2 Đăng nhập (Thu ngân)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenDangNhap\": \"thungan\",\n  \"matKhau\": \"MatKhau@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tai-khoan/dang-nhap",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tai-khoan", "dang-nhap"]
            }
          }
        },
        {
          "name": "1.3 Làm mới Access Token (Refresh Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.ok && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tai-khoan/lam-moi-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tai-khoan", "lam-moi-token"]
            }
          }
        },
        {
          "name": "1.4 Xem hồ sơ cá nhân",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/tai-khoan/ho-so",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tai-khoan", "ho-so"]
            }
          }
        },
        {
          "name": "1.5 Cập nhật hồ sơ cá nhân",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hoTen\": \"Nguyễn Văn Quản Lý\",\n  \"soDienThoai\": \"0901234567\",\n  \"email\": \"quanly@quanmoc.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tai-khoan/ho-so",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tai-khoan", "ho-so"]
            }
          }
        },
        {
          "name": "1.6 Đổi mật khẩu cá nhân",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matKhauCu\": \"MatKhau@123\",\n  \"matKhauMoi\": \"MatKhauMoi@456\",\n  \"xacNhanMatKhauMoi\": \"MatKhauMoi@456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tai-khoan/doi-mat-khau",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tai-khoan", "doi-mat-khau"]
            }
          }
        },
        {
          "name": "1.7 Đăng xuất khỏi hệ thống",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tai-khoan/dang-xuat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tai-khoan", "dang-xuat"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Vai trò & Phân quyền (RBAC)",
      "item": [
        {
