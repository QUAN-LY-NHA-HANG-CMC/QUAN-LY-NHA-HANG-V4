              "mode": "raw",
              "raw": "{\n  \"tenVaiTro\": \"Tổ trưởng phục vụ ca\",\n  \"moTa\": \"Cập nhật mô tả vai trò\",\n  \"trangThai\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vai-tro/5",
